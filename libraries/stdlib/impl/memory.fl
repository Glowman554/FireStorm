function memory_area_set_8(chr[] buffer, chr value, int amount) -> void {
    while amount {
        amount--;
        buffer[amount] = value;
    }
    buffer[amount] = value;
}

function memory_area_set_16(i16[] buffer, i16 value, int amount) -> void {
    amount = amount / 2;
    while amount {
        amount--;
        buffer[amount] = value;
    }
    buffer[amount] = value;
}

function memory_area_set_32(i32[] buffer, i32 value, int amount) -> void {
    amount = amount / 4;
    while amount {
        amount--;
        buffer[amount] = value;
    }
    buffer[amount] = value;
}

function memory_area_set_64(int[] buffer, int value, int amount) -> void {
    amount = amount / 8;
    while amount {
        amount--;
        buffer[amount] = value;
    }
    buffer[amount] = value;
}




function memory_area_copy_8(chr[] dest, chr[] src, int amount) -> void {
    while amount {
        amount--;
        dest[amount] = src[amount];
    }
    dest[amount] = src[amount];
}

function memory_area_copy_16(i16[] dest, i16[] src, int amount) -> void {
    amount = amount / 2;
    while amount {
        amount--;
        dest[amount] = src[amount];
    }
    dest[amount] = src[amount];
}

function memory_area_copy_32(i32[] dest, i32[] src, int amount) -> void {
    amount = amount / 4;
    while amount {
        amount--;
        dest[amount] = src[amount];
    }
    dest[amount] = src[amount];
}

function memory_area_copy_64(int[] dest, int[] src, int amount) -> void {
    amount = amount / 8;
    while amount {
        amount--;
        dest[amount] = src[amount];
    }
    dest[amount] = src[amount];
}




function memory_write_8(int ptr, int value) -> void {
    chr[] tmp = ptr;
    tmp[0] = value;
}

function memory_read_8(int ptr) -> int {
    chr[] tmp = ptr;
    return tmp[0];
}

function memory_write_16(int ptr, int value) -> void {
    i16[] tmp = ptr;
    tmp[0] = value;
}

function memory_read_16(int ptr) -> int {
    i16[] tmp = ptr;
    return tmp[0];
}

function memory_write_32(int ptr, int value) -> void {
    i32[] tmp = ptr;
    tmp[0] = value;
}

function memory_read_32(int ptr) -> int {
    i32[] tmp = ptr;
    return tmp[0];
}

function memory_write_64(int ptr, int value) -> void {
    int[] tmp = ptr;
    tmp[0] = value;
}

function memory_read_64(int ptr) -> int {
    int[] tmp = ptr;
    return tmp[0];
}



function memory_compare_8(chr[] buffer1, chr[] buffer2, int amount) -> int {
    while amount {
        amount--;
        if buffer1[amount] != buffer2[amount] {
            return 0;
        }
    }
    return 1;
}

function memory_compare_16(i16[] buffer1, i16[] buffer2, int amount) -> int {
    amount = amount / 2;
    while amount {
        amount--;
        if buffer1[amount] != buffer2[amount] {
            return 0;
        }
    }
    return 1;
}

function memory_compare_32(i32[] buffer1, i32[] buffer2, int amount) -> int {
    amount = amount / 4;
    while amount {
        amount--;
        if buffer1[amount] != buffer2[amount] {
            return 0;
        }
    }
    return 1;
}

function memory_compare_64(int[] buffer1, int[] buffer2, int amount) -> int {
    amount = amount / 8;
    while amount {
        amount--;
        if buffer1[amount] != buffer2[amount] {
            return 0;
        }
    }
    return 1;
}
