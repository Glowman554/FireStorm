$include <std.fl>

function testStringBuilder(int argc) -> void {
    str string = string_new();
    end {
        string_destroy(string);
    }

    string = string_append(string, "hello with ");
    string = string_append_int(string, argc, 10);
    string = string_append(string, " argument");
    if argc > 1 {
        string = string_append_chr(string, 's');
    }
    prints(string);
}