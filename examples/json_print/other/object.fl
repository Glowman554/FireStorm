$use <stdlib@1.0.7>
$use <json@1.0.1>

$include <std.fl>
$include <json.fl>


function spark(int argc, str[] argv) -> int {
    str jsonTest = "{ \"first_name\": \"John\", \"last_name\": \"Smith\", \"age\": 27, \"address\": { \"street_address\": \"21 2nd Street\", \"city\": \"New York\", \"state\": \"NY\" }, \"phone_numbers\": [ \"212 555-1234\", \"646 555-4567\" ] }";
    prints(jsonTest);

    ptr r = jsonNewReader(jsonTest, string_length(jsonTest));
    end {
        jsonDestroyReader(r);
    }

    ptr object = jsonRead(r);
    end {
        jsonDestroyValue(object);
    }

    ptr outKey = allocate(8);
    ptr outValue = allocate(8);
    end {
        deallocate(outKey);
        deallocate(outValue);
    }

    while jsonIterObject(r, object, outKey, outValue) {
        ptr key = get_ptr(outKey);
        ptr value = get_ptr(outValue);

        jsonPrintValue(key);


        if jsonIsKey(key, "first_name") | jsonIsKey(key, "last_name") | jsonIsKey(key, "age") {
            jsonPrintValue(value);
        } else if jsonIsKey(key, "phone_numbers") {
            ptr outValueArray = allocate(8);
            while jsonIterArray(r, value, outValueArray) {
                ptr valueArray = get_ptr(outValueArray);
                jsonPrintValue(valueArray);
                jsonDestroyValue(valueArray);
            }

            deallocate(outValueArray);
        } else if jsonIsKey(key, "address") {
            ptr outKeyAddress = allocate(8);
            ptr outValueAddress = allocate(8);

            while jsonIterObject(r, value, outKeyAddress, outValueAddress) {
                ptr keyAddress = get_ptr(outKeyAddress);
                ptr valueValue = get_ptr(outValueAddress);

                jsonPrintValue(keyAddress);

                if jsonIsKey(keyAddress, "street_address") | jsonIsKey(keyAddress, "city") | jsonIsKey(keyAddress, "state") {
                    jsonPrintValue(valueValue);
                }

                jsonDestroyValue(keyAddress);
                jsonDestroyValue(valueValue);

                printc('\n');
            }
        }

        jsonDestroyValue(key);
        jsonDestroyValue(value);

        printc('\n');
    }

    return 0;
}
