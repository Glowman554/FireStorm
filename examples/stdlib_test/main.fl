$include <std.fl>

function spark(int argc, str[] argv) -> int {
    int[] array = array_new(8);
    int[] scratch = allocate(8);

    end {
        array_destroy(array);
        deallocate(scratch);
    }


    range 0 .. 64 as i up {
        scratch[0] = i;
        array = array_append(array, scratch);
    }

    range 0 .. array_length(array) as j up {
        printi(array[j]);
    }


    str string = string_from("Hello ");
    end {
        string_destroy(string);
    }
    
    range 0 .. 64 as k up {
        string = string_append_int(string, k, 10);
        string = string_append_chr(string, ' ');
    }

    prints(string);

    return 0;
}
